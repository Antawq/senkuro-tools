{
  "manifest_version": 3,
  "name": "SenkuTools",
  "version": "1.5",
  "description": "Показывает цены на карточки и инструменты аккаунта",
  "permissions": [
    "storage",
    "clipboardWrite",
    "cookies"
  ],
  "background": {
    "scripts": ["background.js"]
  },

  "host_permissions": [
    "*://*.senkuro.com/*",
    "*://*.senkuro.me/*"
  ],
  "icons": {
    "16": "icon_16.png",
    "32": "icon_32.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon_16.png",
      "32": "icon_32.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.senkuro.com/*",
        "*://*.senkuro.me/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "database.json"
      ],
      "matches": [
        "*://*.senkuro.com/*",
        "*://*.senkuro.me/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "senkuro_price@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}